#version 300 es
precision highp float;
precision highp int;

/*__WEGERT_COLOR_CORE__*/

in vec2 v_ndc;
out vec4 frag_color;

uniform vec2 u_center;
uniform float u_half_height;
uniform float u_aspect;
uniform int u_model;
uniform int u_cutoff;
uniform int u_prime;
uniform int u_character;
/* Generated character payload: exact phase exponents supplied by the host.
   -1 is a nonunit; all other entries are in [0, denominator).
   This path does not use a list of guessed zeros or poles. */
uniform int u_generated;
uniform int u_generated_modulus;
uniform int u_generated_denominator;
uniform int u_generated_phases[128];
#ifdef DIRICHLET_NUMERIC_CAPTURE
uniform int u_capture_component;
#endif

const int MAX_GEOMETRIC = 32;
const int MAX_SERIES = 127;
const int MAX_PRIME = 31;

vec2 c_mul(vec2 a, vec2 b) {
    return vec2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x);
}
vec2 c_inverse(vec2 a) {
    float norm = max(dot(a,a), 1.0e-28);
    return vec2(a.x, -a.y) / norm;
}
vec2 n_to_minus_s(float n, vec2 s) {
    float logarithm = log(n);
    float radius = exp(clamp(-s.x * logarithm, -80.0, 80.0));
    float angle = -s.y * logarithm;
    return radius * vec2(cos(angle), sin(angle));
}
vec2 character_value(int id, int n) {
    if (u_generated != 0) {
        int residue = n % u_generated_modulus;
        int exponent = u_generated_phases[residue];
        if (exponent < 0) return vec2(0.0);
        if (exponent == 0) return vec2(1.0,0.0);
        float theta = 6.2831853071795864769 *
            float(exponent) / float(u_generated_denominator);
        return vec2(cos(theta),sin(theta));
    }
    if (id == 0 || id == 5) {
        int r = n % 4;
        if (r == 1) return vec2(1.0,0.0);
        if (r == 3) return vec2(id == 0 ? -1.0 : 1.0,0.0);
        return vec2(0.0);
    }
    if (id == 1) {
        int r = n % 3;
        return vec2(r == 1 ? 1.0 : (r == 2 ? -1.0 : 0.0),0.0);
    }
    if (id == 2 || id == 3) {
        int r = n % 5;
        if (r == 1) return vec2(1.0,0.0);
        if (r == 4) return vec2(-1.0,0.0);
        if (r == 2) return vec2(0.0,id == 2 ? 1.0 : -1.0);
        if (r == 3) return vec2(0.0,id == 2 ? -1.0 : 1.0);
        return vec2(0.0);
    }
    if (id == 4) {
        int r = n % 8;
        if (r == 1 || r == 7) return vec2(1.0,0.0);
        if (r == 3 || r == 5) return vec2(-1.0,0.0);
        return vec2(0.0);
    }
    if (id == 6) return vec2(1.0,0.0);
    return vec2(0.0); // Caller must validate id before binding the uniform.
}
bool is_prime(int n) {
    if (n < 2) return false;
    for (int k = 2; k <= MAX_PRIME; k++) {
        if (k * k > n) break;
        if (n % k == 0) return false;
    }
    return true;
}
vec2 geometric(int n, vec2 q) {
    vec2 sum = vec2(0.0);
    vec2 power = vec2(1.0, 0.0);
    for (int k = 0; k < MAX_GEOMETRIC; k++) {
        if (k >= n) break;
        sum += power;
        power = c_mul(power, q);
    }
    // Correct at q=1; do NOT use the quotient with a fake pole there.
    return sum;
}
vec2 euler_local(int p, vec2 s) {
    vec2 factor = c_mul(character_value(u_character,p),n_to_minus_s(float(p),s));
    return c_inverse(vec2(1.0,0.0)-factor);
}
vec2 character_partial(int cutoff, vec2 s) {
    vec2 sum = vec2(0.0);
    for (int n = 1; n <= MAX_SERIES; n++) {
        if (n > cutoff) break;
        sum += c_mul(character_value(u_character,n),n_to_minus_s(float(n),s));
    }
    return sum;
}
vec2 character_product(int cutoff, vec2 s) {
    vec2 value = vec2(1.0,0.0);
    for (int p = 2; p <= MAX_PRIME; p++) {
        if (p > cutoff) break;
        if (is_prime(p)) value = c_mul(value,euler_local(p,s));
    }
    return value;
}
void main() {
    vec2 z = u_center + vec2(
        v_ndc.x * u_half_height * u_aspect,
        v_ndc.y * u_half_height
    );
    vec2 value = vec2(0.0);
    if (u_model == 0) value = geometric(u_cutoff, z);
    else if (u_model == 1) value = euler_local(u_prime, z);
    else if (u_model == 2) value = character_partial(u_cutoff, z);
    else value = character_product(u_cutoff, z);
#ifdef DIRICHLET_NUMERIC_CAPTURE
    // Read this exact evaluator as float32 bytes from a 1x1 RGBA8 FBO.
    // Two passes select real and imaginary components.
    float component = u_capture_component == 0 ? value.x : value.y;
    uint bits = floatBitsToUint(component);
    uvec4 octets = uvec4(
        bits & 255u, (bits >> 8u) & 255u,
        (bits >> 16u) & 255u, (bits >> 24u) & 255u
    );
    frag_color = vec4(octets) / 255.0;
#else
    frag_color = vec4(wegert_color_complex(value), 1.0);
#endif
}
